# ==============================================================================
# ZEZ AUTOMATION CORPORATION - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env or .env.local for local development.
# NEVER commit your actual .env or .env.local file with real keys to Git.
# ==============================================================================

# --- SUPABASE CONFIGURATION (POSTGRESQL & CLOUD PERSISTENCE) ---
# Obtain these from your Supabase Dashboard: Project Settings -> API
# Required for syncing products, categories, customer inquiries, and RFQs to PostgreSQL.
# If omitted or left blank, the website automatically operates in interactive demo mode using LocalStorage.
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
VITE_SUPABASE_ANON_KEY="your-anon-public-api-key"

# --- GEMINI AI API (OPTIONAL) ---
# Used for server-side AI-assisted technical bill-of-materials and product recommendations.
# Automatically injected in AI Studio.
GEMINI_API_KEY=""

# --- APPLICATION HOSTING URL ---
# The public canonical URL of your deployed application (e.g. on Vercel or custom domain).
# Used for OpenGraph social cards, SEO canonical links, and webhook callbacks.
APP_URL="https://zezautomation.ph"
